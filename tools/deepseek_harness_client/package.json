{
  "name": "deepseek-harness-client",
  "version": "1.1.0",
  "private": true,
  "description": "A polished and secure local desktop client for DeepSeek Harness Web.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.harnessclient",
    "productName": "DeepSeek Harness Client",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
